{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/cli/sprints-list.json",
  "title": "sprints list --json",
  "description": "The newest sprints first; a future sprint has null start and end; board is the origin board id.",
  "type": "object",
  "properties": {
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "sprints": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/sprint"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "site",
    "sprints"
  ]
}
