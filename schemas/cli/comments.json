{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/cli/comments.json",
  "title": "comments --json",
  "description": "Comments of one ticket in the requested order.",
  "type": "object",
  "properties": {
    "key": {
      "$ref": "../defs.json#/$defs/key"
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/comment"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "site",
    "items",
    "total",
    "truncated"
  ]
}
