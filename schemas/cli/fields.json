{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/cli/fields.json",
  "title": "fields --json",
  "description": "fields list prints fields and mapping; fields check prints problems (exit 22 when any); fields refresh prints refreshed.",
  "type": "object",
  "properties": {
    "action": {
      "enum": [
        "list",
        "check",
        "refresh"
      ]
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "name": {
            "type": "string",
            "maxLength": 256,
            "x-untrusted": true
          },
          "custom": {
            "type": "boolean"
          },
          "schema": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "items": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "custom": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "logical": {
            "enum": [
              "estimate",
              "acceptance_criteria",
              "sprint",
              "parent",
              "epic",
              "labels",
              "priority",
              "assignee",
              "resolution",
              "due_date",
              null
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "custom",
          "schema",
          "logical"
        ]
      }
    },
    "mapping": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "estimate",
          "acceptance_criteria",
          "sprint",
          "parent",
          "epic",
          "labels",
          "priority",
          "assignee",
          "resolution",
          "due_date"
        ]
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "name": {
                "type": "string",
                "maxLength": 256,
                "x-untrusted": true
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "logical": {
            "type": "string",
            "maxLength": 64
          },
          "problem": {
            "enum": [
              "missing",
              "ambiguous",
              "type_mismatch"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256,
              "x-untrusted": true
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "logical",
          "problem"
        ]
      }
    },
    "refreshed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "action",
    "site"
  ]
}
