{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/adf.json",
  "title": "ticketctl ADF allowlist",
  "description": "The only document shapes ticketctl sends: nodes doc, paragraph, text, heading, bulletList, orderedList, listItem, codeBlock, blockquote and hardBreak; marks strong, em, code and link (http or https, no userinfo). A text node has each mark type at most once, and code combines only with link; a codeBlock holds plain text nodes without marks. Every other node, mark or attribute is refused, never repaired. Depth 10 (containers: list, listItem, blockquote), 5000 nodes, the body size and the sanitizer rule for text are enforced by validate_adf() in code, not by this schema. The href is at most 2000 characters after the http(s):// scheme, printable ASCII without backslash. The patterns end in (?![\\s\\S]) (end of string) rather than $, which some validators let match before a trailing newline. The unique-mark and code-only-with-link rules need a JSON Schema Draft 2019-09 or later validator (maxContains, if/then); older validators ignore them, and the code validator remains the authority. Known gaps between this schema and the code validator: a float such as 1.0 counts as an integer for a schema validator but is refused by the code, and lone surrogates and carriage returns in text are refused by the code only (the sanitizer rule).",
  "$ref": "#/$defs/doc",
  "$defs": {
    "mark": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "strong",
                "em",
                "code"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "link"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string",
                  "pattern": "^(?!https?://[^/?#]*@)https?://[\\x21-\\x5b\\x5d-\\x7e]{1,2000}(?![\\s\\S])"
                }
              },
              "additionalProperties": false,
              "required": [
                "href"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "attrs"
          ]
        }
      ]
    },
    "text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "type": {
                    "const": "strong"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "type": {
                    "const": "em"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "type": {
                    "const": "code"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "type": {
                    "const": "link"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "if": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "code"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              },
              "then": {
                "items": {
                  "properties": {
                    "type": {
                      "enum": [
                        "code",
                        "link"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ]
    },
    "codeText": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ]
    },
    "hardBreak": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hardBreak"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/hardBreak"
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "heading": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heading"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "additionalProperties": false,
          "required": [
            "level"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "attrs"
      ]
    },
    "codeBlock": {
      "type": "object",
      "properties": {
        "type": {
          "const": "codeBlock"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+#._-]{1,32}(?![\\s\\S])"
            }
          },
          "additionalProperties": false,
          "required": []
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeText"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "listItem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "listItem"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ]
    },
    "bulletList": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bulletList"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ]
    },
    "orderedList": {
      "type": "object",
      "properties": {
        "type": {
          "const": "orderedList"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "order": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          },
          "additionalProperties": false,
          "required": []
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ]
    },
    "blockquote": {
      "type": "object",
      "properties": {
        "type": {
          "const": "blockquote"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/codeBlock"
        },
        {
          "$ref": "#/$defs/bulletList"
        },
        {
          "$ref": "#/$defs/orderedList"
        },
        {
          "$ref": "#/$defs/blockquote"
        }
      ]
    },
    "doc": {
      "type": "object",
      "properties": {
        "type": {
          "const": "doc"
        },
        "version": {
          "const": 1
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "content"
      ]
    }
  }
}
