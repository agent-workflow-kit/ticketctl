{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/hooks/pre-create.json",
  "title": "pre-create hook payload (stdin)",
  "description": "pre- hook: runs after the confirmation and before the first provider write; exit 13 escalates, any other non-zero exit vetoes. The attempt_id is provisional: no audit record follows a veto, a stale refusal or a decline. object_id is the ticket key (create only: null for pre-create, and for a post-create that created nothing). changed is null for an unknown outcome. No repo, no labels, no ticket text.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticketctl"
    },
    "hook": {
      "const": "pre-create"
    },
    "object_type": {
      "const": "ticket"
    },
    "object_id": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/key"
        },
        {
          "type": "null"
        }
      ]
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "project": {
      "$ref": "../defs.json#/$defs/project_key"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "attempt_id": {
      "$ref": "../defs.json#/$defs/attempt_id"
    },
    "decision_ids": {
      "$ref": "../defs.json#/$defs/decision_ids"
    },
    "plan": {
      "type": "object",
      "properties": {
        "action": {
          "const": "create"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/step_kind"
          }
        },
        "fields_changed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "plan_sha256": {
          "$ref": "../defs.json#/$defs/sha256"
        },
        "dedupe_key": {
          "oneOf": [
            {
              "$ref": "../defs.json#/$defs/dedupe_key"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "steps",
        "fields_changed",
        "plan_sha256",
        "dedupe_key"
      ]
    },
    "body": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha256": {
            "$ref": "../defs.json#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes"
        ]
      },
      "description": "Size and sha256 of each body; never text."
    },
    "create": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 256
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "../defs.json#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "assign": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "parent",
        "assign"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "site",
    "project",
    "actor",
    "attempt_id",
    "decision_ids",
    "plan",
    "body",
    "create"
  ]
}
