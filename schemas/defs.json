{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/defs.json",
  "title": "ticketctl shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the CLI, hook, audit and log schemas. config.json embeds its own copies.",
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$",
      "maxLength": 64,
      "description": "Ticket key, upper case: PROJECT-NUMBER."
    },
    "project_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 64
    },
    "site_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "description": "A configured site name."
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
      "description": "The provider's own id."
    },
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "description": "UTC ISO 8601 with Z."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "actor": {
      "type": "string",
      "pattern": "^(?:human|auto):[A-Za-z0-9._@-]{1,64}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,128}$"
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision_id"
      },
      "maxItems": 16
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{8,64}$",
      "description": "Shared by the records of one command."
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Caller-chosen, up to 128 bytes, never secret."
    },
    "status_category": {
      "enum": [
        "new",
        "indeterminate",
        "done"
      ]
    },
    "sprint_state": {
      "enum": [
        "future",
        "active",
        "closed"
      ]
    },
    "action": {
      "enum": [
        "transition",
        "comment",
        "create",
        "update",
        "sprint_add",
        "sprint_remove"
      ]
    },
    "step_kind": {
      "enum": [
        "assign",
        "transition",
        "set_fields",
        "add_comment",
        "create",
        "sprint_add",
        "sprint_remove"
      ]
    },
    "hook_name": {
      "enum": [
        "pre-transition",
        "post-transition",
        "pre-comment",
        "post-comment",
        "pre-create",
        "post-create",
        "pre-update",
        "post-update",
        "pre-sprint",
        "post-sprint"
      ]
    },
    "error_code": {
      "enum": [
        "internal",
        "usage",
        "invalid_config",
        "not_found",
        "vetoed",
        "invalid_request",
        "auth_required",
        "bad_credentials",
        "forbidden",
        "rejected",
        "unavailable",
        "timeout",
        "outcome_unknown",
        "rate_limited",
        "provider_changed",
        "confirmation_required",
        "escalated",
        "stale_ticket",
        "no_such_transition",
        "needs_assignee",
        "sprint_closed",
        "already_exists",
        "ambiguous_site",
        "ambiguous_field",
        "ambiguous_transition",
        "ambiguous_board",
        "ambiguous_sprint"
      ]
    },
    "error_reason": {
      "enum": [
        "invalid_query",
        "unknown_field",
        "not_editable",
        "invalid_value",
        "needs_resolution",
        "missing_required_fields",
        "node_not_allowed",
        "body_too_large",
        "empty_body",
        "unknown_site",
        "invalid_key",
        "confirmation_required",
        "escalated"
      ]
    },
    "incomplete": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]{0,63}$"
      },
      "uniqueItems": true,
      "description": "Parts cut off or unavailable (links, comments, attachments, ...), also truncated fields."
    },
    "status": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "category": {
          "$ref": "#/$defs/status_category"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "category"
      ]
    },
    "account": {
      "type": "object",
      "properties": {
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "display_name": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        }
      },
      "additionalProperties": false,
      "required": [
        "account_id",
        "display_name"
      ]
    },
    "sprint_ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        },
        "state": {
          "$ref": "#/$defs/sprint_state"
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state",
        "start",
        "end"
      ]
    },
    "sprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        },
        "state": {
          "$ref": "#/$defs/sprint_state"
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/ts"
            },
            {
              "type": "null"
            }
          ]
        },
        "board": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state",
        "start",
        "end",
        "board"
      ]
    },
    "parent": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "type": "string",
          "maxLength": 256
        },
        "title": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "title"
      ]
    },
    "link": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 256
        },
        "direction": {
          "enum": [
            "inward",
            "outward"
          ]
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "status_category": {
          "oneOf": [
            {
              "$ref": "#/$defs/status_category"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4096,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "direction",
        "key",
        "status_category",
        "summary"
      ]
    },
    "comment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/provider_id"
        },
        "author": {
          "$ref": "#/$defs/account"
        },
        "own": {
          "type": "boolean"
        },
        "created": {
          "$ref": "#/$defs/ts"
        },
        "updated": {
          "$ref": "#/$defs/ts"
        },
        "body": {
          "type": "string",
          "maxLength": 1000000,
          "x-untrusted": true
        },
        "dedupe_key_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "author",
        "own",
        "created",
        "updated",
        "body",
        "dedupe_key_sha256"
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/provider_id"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "to": {
          "$ref": "#/$defs/status"
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "maxLength": 64
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ]
          }
        },
        "has_screen": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "to",
        "required_fields",
        "has_screen"
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/step_kind"
        },
        "account": {
          "type": "string",
          "maxLength": 128,
          "description": "assign: me, none or an account id."
        },
        "transition_id": {
          "$ref": "#/$defs/provider_id"
        },
        "to": {
          "type": "string",
          "maxLength": 256
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256
          }
        },
        "body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "body_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sprint": {
          "type": "string",
          "maxLength": 64
        },
        "project": {
          "$ref": "#/$defs/project_key"
        },
        "type": {
          "type": "string",
          "maxLength": 256
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "One provider call in plain terms; only the properties that apply to the kind are present."
    },
    "change": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "from": {
          "x-untrusted": true,
          "description": "Current value (any JSON); rich text in full."
        },
        "to": {
          "x-untrusted": true,
          "description": "New value (any JSON); rich text in full."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "from",
        "to"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "key": {
          "oneOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "dedupe_key": {
          "oneOf": [
            {
              "$ref": "#/$defs/dedupe_key"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "site",
        "key",
        "actor",
        "steps",
        "changes",
        "warnings",
        "dedupe_key",
        "plan_sha256"
      ],
      "description": "The plan of a write; key is null for create."
    },
    "result": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "changed": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "ok",
            "partial",
            "unchanged"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#/$defs/step_kind"
              },
              "status": {
                "enum": [
                  "done",
                  "skipped",
                  "failed"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "status"
            ]
          }
        },
        "already_posted": {
          "type": "boolean"
        },
        "reused": {
          "type": "boolean"
        },
        "comment_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/provider_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/attempt_id"
        },
        "decision_ids": {
          "$ref": "#/$defs/decision_ids"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "site",
        "key",
        "changed",
        "result",
        "steps",
        "attempt_id",
        "decision_ids"
      ],
      "description": "The outcome of a write. partial: an earlier step was applied and a later one failed; nothing is rolled back."
    },
    "error_body": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "maxLength": 4096,
          "x-untrusted": true
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_s": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome_unknown": {
          "type": "boolean"
        },
        "site": {
          "oneOf": [
            {
              "$ref": "#/$defs/site_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "oneOf": [
            {
              "$ref": "#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "oneOf": [
            {
              "$ref": "#/$defs/error_details"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "reason",
        "retryable",
        "retry_after_s",
        "outcome_unknown",
        "site",
        "key",
        "details"
      ],
      "description": "reason is set for exit 22 (invalid_request) and exit 13, null otherwise.",
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "invalid_request"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "invalid_query",
                  "unknown_field",
                  "not_editable",
                  "invalid_value",
                  "needs_resolution",
                  "missing_required_fields",
                  "node_not_allowed",
                  "body_too_large",
                  "empty_body",
                  "unknown_site",
                  "invalid_key"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "confirmation_required",
                  "escalated"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "confirmation_required",
                  "escalated"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_request",
                  "confirmation_required",
                  "escalated"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "error_details": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "x-untrusted": true
          }
        },
        "available_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "x-untrusted": true
          }
        },
        "field": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 256,
            "x-untrusted": true
          }
        },
        "option": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        },
        "token": {
          "type": "string",
          "maxLength": 256,
          "x-untrusted": true
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "hook": {
          "$ref": "#/$defs/hook_name"
        },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
        },
        "errorMessages": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096,
            "x-untrusted": true
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "x-untrusted": true
          },
          "x-untrusted": true
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "limit": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "remaining": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "limit",
            "remaining"
          ]
        }
      },
      "additionalProperties": false,
      "required": [],
      "description": "The structured part of an error; which keys appear depends on the code."
    },
    "ticket": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "site": {
          "$ref": "#/$defs/site_name"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "id": {
          "$ref": "#/$defs/provider_id"
        },
        "type": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 256
            },
            "subtask": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "subtask"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 4096,
          "x-untrusted": true
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000000,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ],
          "description": "Untrusted Markdown rendered from the provider's rich text."
        },
        "description_adf": {
          "type": "object",
          "x-untrusted": true,
          "description": "Only with --include-adf. The provider's document, passed through."
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "resolution": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee": {
          "oneOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "reporter": {
          "oneOf": [
            {
              "$ref": "#/$defs/account"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "rank": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "rank"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
