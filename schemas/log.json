{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/log.json",
  "title": "ticketctl log.jsonl record",
  "description": "Public request log, one line per provider call. No headers, no bodies, no values.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "site": {
      "$ref": "defs.json#/$defs/site_name"
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?:/(?:[A-Za-z0-9._~-]+|\\{[a-z_]+\\}))+$",
      "maxLength": 256,
      "description": "The full path template, for example /rest/api/3/issue/{key}; placeholders, never values."
    },
    "status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599,
      "description": "null when no response arrived."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "rate_limit_remaining": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "host": {
      "type": "string",
      "pattern": "^(?:[a-z0-9.-]{1,253}|\\[[0-9a-f:]{2,45}\\])(?::[0-9]{1,5})?$",
      "maxLength": 300,
      "description": "The host and optional port requested."
    },
    "config_sha256": {
      "$ref": "defs.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "required": [
    "v",
    "ts",
    "site",
    "method",
    "path",
    "status",
    "duration_ms",
    "retries",
    "rate_limit_remaining",
    "host",
    "config_sha256"
  ]
}
