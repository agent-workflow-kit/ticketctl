{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/log.json",
  "title": "ticketctl log.jsonl record",
  "description": "Public request log, one line per provider call. No headers, no bodies, no values.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "site": {
      "$ref": "defs.json#/$defs/site_name"
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^(?:/(?:[A-Za-z0-9._~-]+|\\{[a-z_]+\\}))+$",
      "maxLength": 256,
      "description": "A path template: placeholders such as {key}, never values."
    },
    "status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599,
      "description": "null when no response arrived."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "rate_limit_remaining": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "ts",
    "site",
    "method",
    "path",
    "status",
    "duration_ms",
    "retries",
    "rate_limit_remaining"
  ]
}
