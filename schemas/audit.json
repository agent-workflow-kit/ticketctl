{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticketctl/audit.json",
  "title": "ticketctl audit.jsonl record",
  "description": "Public, append-only. One record pair (attempted, then the outcome) per provider write call, sharing attempt_id and numbered by step. failed: a definite refusal or error (changed false); partial: a definite failure after an earlier step of the command landed (changed false); unknown: a request that may have been sent with no answer (changed null, whether or not an earlier step landed). No body text, no titles, no secrets. reason is optional (the error code of a failed, partial or unknown outcome). Closed for the producer; a consumer tolerates unknown properties.",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "attempt_id": {
      "$ref": "defs.json#/$defs/attempt_id"
    },
    "step": {
      "type": "integer",
      "minimum": 1
    },
    "step_kind": {
      "$ref": "defs.json#/$defs/step_kind"
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ]
    },
    "stdin_tty": {
      "type": "boolean"
    },
    "decision_id": {
      "$ref": "defs.json#/$defs/decision_ids"
    },
    "target": {
      "type": "object",
      "properties": {
        "site": {
          "$ref": "defs.json#/$defs/site_name"
        },
        "key": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/key"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "site",
        "key"
      ]
    },
    "action": {
      "$ref": "defs.json#/$defs/action"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "plan_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sha256": {
                "$ref": "defs.json#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false,
            "required": [
              "sha256",
              "bytes"
            ]
          }
        },
        "dedupe_key": {
          "oneOf": [
            {
              "$ref": "defs.json#/$defs/dedupe_key"
            },
            {
              "type": "null"
            }
          ]
        },
        "override_escalation": {
          "oneOf": [
            {
              "enum": [
                "ticketctl"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "type": "object",
          "properties": {
            "path": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "files_sha256": {
              "type": "array",
              "items": {
                "$ref": "defs.json#/$defs/sha256"
              }
            },
            "sha256": {
              "$ref": "defs.json#/$defs/sha256"
            }
          },
          "additionalProperties": false,
          "required": [
            "path",
            "files_sha256",
            "sha256"
          ]
        },
        "hooks_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        },
        "site_host": {
          "type": "string",
          "pattern": "^(?:[a-z0-9.-]{1,253}|\\[[0-9a-f:]{2,45}\\])(?::[0-9]{1,5})?$",
          "maxLength": 300,
          "description": "The host and optional port requested."
        },
        "cli_hooks": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/hook_name"
          },
          "uniqueItems": true
        },
        "token_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "description": "The variable name, never a value."
        }
      },
      "additionalProperties": false,
      "required": [
        "plan_sha256",
        "override_escalation",
        "config",
        "hooks_sha256",
        "site_host",
        "cli_hooks",
        "token_env"
      ]
    },
    "result": {
      "enum": [
        "attempted",
        "ok",
        "failed",
        "partial",
        "unknown"
      ]
    },
    "provider_ids": {
      "type": "array",
      "items": {
        "$ref": "defs.json#/$defs/provider_id"
      }
    },
    "changed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/error_code"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "v",
    "seq",
    "ts",
    "attempt_id",
    "step",
    "step_kind",
    "actor",
    "actor_source",
    "stdin_tty",
    "decision_id",
    "target",
    "action",
    "inputs",
    "result",
    "provider_ids",
    "changed"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "attempted"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "changed": {
            "type": "null"
          },
          "provider_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "attempted",
              "unknown"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "changed": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "changed": {
            "type": "boolean"
          }
        }
      }
    }
  ]
}
